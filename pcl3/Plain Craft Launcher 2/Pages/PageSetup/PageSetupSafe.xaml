<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageSetupSafe"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15,0,15" Title="防火墙">
                <StackPanel Margin="25,40,25,15">
                    <local:MyHint Text="防火墙会在启动游戏前扫描 mods 文件夹，查找病毒模组与植入木马的恶意模组（如 fractureiser 家族）；游戏运行期间还会监视 Java 进程的可疑子进程与开机自启项的变更。&#xa;启发式扫描可能误报，可在警告弹窗中选择信任。" Theme="Blue" Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="28" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="防火墙" Margin="0,0,25,0"
                                   ToolTip="开启后：启动前扫描模组 + 游戏运行期间监控可疑行为。&#xa;关闭后不再产生任何扫描与监控开销，但也失去保护。" />
                        <local:MyCheckBox x:Name="CheckSafeEnabled" local:SettingService.Key="SystemSafeEnabled" Grid.Column="1" HorizontalAlignment="Left"
                                          Text="启用防火墙"
                                          ToolTip="开启后：启动前扫描模组 + 游戏运行期间监控可疑行为。&#xa;关闭后不再产生任何扫描与监控开销，但也失去保护。" />
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="发现威胁时" Margin="0,0,25,0" Grid.Row="2"
                                   ToolTip="仅提示：弹出警告弹窗，由你决定是否继续启动。&#xa;阻止启动：默认拦截，需要手动选择「无视风险并启动」才能继续。" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <local:MyRadioBox x:Name="RadioSafeMode0" local:SettingService.Key="SystemSafeMode" local:SettingService.Value="0"
                                              Text="仅提示" Width="110" Margin="0,0,20,0" Checked="True"
                                              ToolTip="发现可疑模组时弹出警告，由你选择是否继续启动。" />
                            <local:MyRadioBox x:Name="RadioSafeMode1" local:SettingService.Key="SystemSafeMode" local:SettingService.Value="1"
                                              Text="阻止启动" Width="110"
                                              ToolTip="发现可疑模组时默认取消启动，需要手动选择「无视风险并启动」才能继续。" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="模组扫描">
                <StackPanel Margin="25,40,25,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="35" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="启动前扫描" Margin="0,0,25,0"
                                   ToolTip="每次启动游戏前，扫描当前版本 mods 文件夹中的全部 Jar。&#xa;结果按文件缓存：首次扫描较慢，之后不影响启动速度。" />
                        <local:MyCheckBox x:Name="CheckSafeScan" local:SettingService.Key="SystemSafeScan" Grid.Column="1" HorizontalAlignment="Left"
                                          Text="启用"
                                          ToolTip="每次启动游戏前，扫描当前版本 mods 文件夹中的全部 Jar。&#xa;结果按文件缓存：首次扫描较慢，之后不影响启动速度。" />
                        <TextBlock x:Name="LabLastScan" Grid.Row="2" Grid.ColumnSpan="2" Text="尚未进行过手动扫描。" TextWrapping="Wrap" Opacity="0.7" />
                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal">
                            <local:MyButton x:Name="BtnSafeScan" Text="立即扫描当前版本" MinWidth="140" Height="35" Padding="13,0" Margin="0,0,20,0" ColorType="Highlight"
                                            ToolTip="立即扫描当前选中版本的 mods 文件夹，并显示完整报告（包含每个可疑文件命中的具体特征）。" />
                            <local:MyButton x:Name="BtnSafeWhitelist" Text="管理白名单" MinWidth="140" Height="35" Padding="13,0" Margin="0,0,20,0"
                                            ToolTip="查看 / 清空已信任的模组文件列表。白名单内的文件不再触发扫描警告。" />
                            <local:MyButton x:Name="BtnSafeLog" Text="查看记录" MinWidth="140" Height="35" Padding="13,0"
                                            ToolTip="打开防火墙日志（全部扫描结果、放行与拦截记录）。" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="运行时防护">
                <StackPanel Margin="25,40,25,15">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="游戏进程监控" Margin="0,0,25,0"
                                   ToolTip="游戏运行期间持续检查 Java 进程及其全部子进程，发现异常立即弹窗，可选择一键结束。" />
                        <local:MyCheckBox x:Name="CheckSafeWatch" local:SettingService.Key="SystemSafeWatch" Grid.Column="1" HorizontalAlignment="Left"
                                          Text="启用"
                                          ToolTip="游戏运行期间持续检查 Java 进程及其全部子进程，发现异常立即弹窗，可选择一键结束。" />
                    </Grid>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" LineHeight="21"
                               Text="每 2 秒检查 Java 进程启动的可疑子进程（PowerShell、cmd、wscript、certutil 等脚本与下载工具）——这是恶意模组执行木马载荷的典型行为，发现后可一键结束游戏与可疑进程；&#xa;每 15 秒对比开机自启位置（注册表 Run 键、启动文件夹），发现游戏运行期间新增的自启项（木马植入持久化的典型行为）立即警报。" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
