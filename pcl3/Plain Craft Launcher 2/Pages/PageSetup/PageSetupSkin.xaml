<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageSetupSkin"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <Grid x:Name="PanMain" Margin="25,10">
            <local:MyCard x:Name="CardSkin" Margin="0,15" Title="更衣室" UseAnimation="False">
                <Grid Margin="25,40,25,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid Margin="0,0,15,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" MinHeight="240" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="PanTabs" Orientation="Horizontal" Margin="0,0,0,10">
                            <local:MyListItem x:Name="ItemSkin" Title="皮肤" Tag="0" Type="RadioBox" Checked="True" Width="86" Height="34" MinPaddingRight="16" IsScaleAnimationEnabled="False" />
                            <local:MyListItem x:Name="ItemCape" Title="披风" Tag="1" Type="RadioBox" Width="86" Height="34" MinPaddingRight="16" IsScaleAnimationEnabled="False" />
                        </StackPanel>
                        <Border Grid.Row="1" Background="{StaticResource ColorBrushSemiTransparent}" CornerRadius="8" Padding="6,6,2,6">
                            <Grid>
                                <local:MyScrollViewer x:Name="PanSkinScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="PanSkinList" Margin="0,0,4,0" />
                                </local:MyScrollViewer>
                                <local:MyScrollViewer x:Name="PanCapeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                                    <StackPanel x:Name="PanCapeList" Margin="0,0,4,0" />
                                </local:MyScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" MinHeight="240" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource ColorBrushSemiTransparent}" CornerRadius="8" ClipToBounds="True">
                            <local:MySkinViewer x:Name="Viewer" />
                        </Border>
                        <TextBlock Text="拖动旋转，滚轮缩放" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" FontSize="11" IsHitTestVisible="False" Foreground="{DynamicResource ColorBrushGray2}" />
                        <StackPanel Grid.Row="1" x:Name="PanSkin" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <local:MyButton x:Name="BtnSkinImport" Height="30" Text="导入皮肤" Margin="0,0,10,0" Click="BtnSkinImport_Click" />
                                <local:MyButton x:Name="BtnSkinApply" Height="30" Text="应用皮肤" Margin="0,0,10,0" ColorType="Highlight" Click="BtnSkinApply_Click" />
                                <local:MyButton x:Name="BtnSkinSave" Height="30" Text="保存皮肤" Margin="0,0,10,0" Click="BtnSkinSave_Click" />
                                <local:MyButton x:Name="BtnSkinReset" Height="30" Text="重置视角" Click="BtnSkinReset_Click" />
                            </StackPanel>
                            <TextBlock x:Name="LabSkinHint" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" x:Name="PanCape" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <local:MyButton x:Name="BtnCapeRefresh" Height="30" Text="刷新披风列表" Margin="0,0,10,0" Click="BtnCapeRefresh_Click" />
                                <local:MyButton x:Name="BtnCapeApply" Height="30" Text="应用所选披风" Margin="0,0,10,0" ColorType="Highlight" Click="BtnCapeApply_Click" />
                                <local:MyButton x:Name="BtnCapeReset" Height="30" Text="重置视角" Click="BtnCapeReset_Click" />
                            </StackPanel>
                            <TextBlock x:Name="LabCapeHint" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource ColorBrushGray2}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </local:MyCard>
        </Grid>
    </local:MyScrollViewer>
</local:MyPageRight>
