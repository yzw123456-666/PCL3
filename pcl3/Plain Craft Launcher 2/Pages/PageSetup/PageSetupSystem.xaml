<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d" x:Class="PageSetupSystem"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <local:MyCard Margin="0,15" Title="下载">
                <StackPanel Margin="25,37,25,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="27" />
                            <RowDefinition Height="27" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="文件下载源" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboDownloadSource" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadSource" Grid.Column="1">
                            <local:MyComboBoxItem Content="尽量使用镜像源" />
                            <local:MyComboBoxItem Content="优先使用官方源，在加载缓慢时换用镜像源" IsSelected="True" />
                            <local:MyComboBoxItem Content="尽量使用官方源" />
                        </local:MyComboBox>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="版本列表源" Margin="0,0,25,0" Grid.Row="2" />
                        <local:MyComboBox x:Name="ComboDownloadVersion" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadVersion" Grid.Column="1" Grid.Row="2">
                            <local:MyComboBoxItem Content="尽量使用镜像源（可能缺少刚刚更新的版本）" />
                            <local:MyComboBoxItem Content="优先使用官方源，在加载缓慢时换用镜像源" IsSelected="True" />
                            <local:MyComboBoxItem Content="尽量使用官方源" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="最大线程数" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderDownloadThread" Grid.Row="4" local:SettingService.Key="ToolDownloadThread" MaxValue="255" Value="63" Grid.Column="1"
                                        ToolTip="线程数越多，限速的文件下载越快，但过高的线程数会造成下载时非常严重的卡顿。&#xa;一般而言，64 线程已可以保证足够的下载速度。" />
                        <TextBlock VerticalAlignment="Center" Grid.Row="5" HorizontalAlignment="Left" Text="速度限制" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderDownloadSpeed" Grid.Row="5" local:SettingService.Key="ToolDownloadSpeed" MaxValue="42" Value="42" Grid.Column="1"
                                        ToolTip="设置下载的速度上限，以避免在下载时导致其他需要联网的程序卡死" />
                        <TextBlock VerticalAlignment="Top" Grid.Row="6" HorizontalAlignment="Left" Text="目标文件夹" Margin="0,5,25,5" />
                        <TextBlock Margin="0,5" HorizontalAlignment="Left" Text="请在 启动 → 版本选择 → 文件夹列表 中更改下载目标文件夹。&#xa;在某个文件夹或游戏版本上右键，即可选择打开对应文件夹。" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="社区资源">
                <StackPanel Margin="25,37,25,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="7" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="来源" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboDownloadMod" Grid.Row="0" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadMod" Grid.Column="1">
                            <local:MyComboBoxItem Content="尽量使用镜像源（可能缺少刚刚更新的版本）" />
                            <local:MyComboBoxItem Content="仅在官方源加载缓慢时改用镜像源" />
                            <local:MyComboBoxItem Content="尽量使用官方源" IsSelected="True" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="文件名格式" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Row="2" x:Name="ComboDownloadTranslateV2" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadTranslateV2" Grid.Column="1" 
                                          ToolTip="下载社区资源时，其默认文件名的格式">
                            <local:MyComboBoxItem Content="【机械动力】create-1.21.1-6.0.4" />
                            <local:MyComboBoxItem Content="[机械动力] create-1.21.1-6.0.4" IsSelected="True" />
                            <local:MyComboBoxItem Content="机械动力-create-1.21.1-6.0.4" />
                            <local:MyComboBoxItem Content="create-1.21.1-6.0.4-机械动力" />
                            <local:MyComboBoxItem Content="create-1.21.1-6.0.4" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="Mod 管理样式" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Row="4" x:Name="ComboModLocalNameStyle" Grid.ColumnSpan="2" local:SettingService.Key="ToolModLocalNameStyle" Grid.Column="1" 
                                          ToolTip="在 Mod 管理页面中，Mod 项的显示方式">
                            <local:MyComboBoxItem Content="标题显示译名，详情显示文件名" IsSelected="True" />
                            <local:MyComboBoxItem Content="标题显示文件名，详情显示译名" />
                        </local:MyComboBox>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="辅助功能">
                <Grid Margin="25,40,25,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="游戏更新提示" Margin="0,0,25,0" />
                    <local:MyCheckBox Text="正式版更新提示" Grid.Column="1" x:Name="CheckUpdateRelease" local:SettingService.Key="ToolUpdateRelease" ToolTip="在 Minecraft 正式版更新时弹窗提示" />
                    <local:MyCheckBox Text="测试版更新提示" Grid.Column="2" Height="22" x:Name="CheckUpdateSnapshot" local:SettingService.Key="ToolUpdateSnapshot" ToolTip="在 Minecraft 测试版（快照、预发布版）更新时弹窗提示" />
                    <TextBlock VerticalAlignment="Center" Grid.Row="2" HorizontalAlignment="Left" Text="游戏语言" Margin="0,0,25,0" />
                    <local:MyCheckBox Text="自动设置为中文" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" x:Name="CheckHelpChinese" local:SettingService.Key="ToolHelpChinese" />
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="启动器">
                <Grid Margin="25,40,25,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="9" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="启动器更新" Margin="0,0,25,0" />
                    <local:MyComboBox x:Name="ComboSystemUpdate" local:SettingService.Key="SystemSystemUpdate" Grid.Column="1">
                        <local:MyComboBoxItem Content="在有新版本时自动下载" x:Name="ItemSystemUpdateDownload" />
                        <local:MyComboBoxItem Content="在有新版本时显示提示" />
                        <local:MyComboBoxItem Content="仅在有重大漏洞更新时显示提示" />
                        <local:MyComboBoxItem Content="关闭更新提示" />
                    </local:MyComboBox>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="启动器公告" Margin="0,0,25,0" Grid.Row="2" />
                    <local:MyComboBox x:Name="ComboSystemActivity" local:SettingService.Key="SystemSystemActivity" Grid.Column="1" Grid.Row="2">
                        <local:MyComboBoxItem Content="显示所有公告" ToolTip="显示包括启动器功能调查、活动等在内的全部公告" />
                        <local:MyComboBoxItem Content="仅在有重要通知时显示公告" />
                        <local:MyComboBoxItem Content="关闭所有公告" />
                    </local:MyComboBox>
                    <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="缓存文件夹" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextSystemCache" Grid.Row="4" Grid.ColumnSpan="2" local:SettingService.Key="SystemSystemCache" Grid.Column="1" ToolTip="PCL 的下载、皮肤等缓存文件的存储位置。&#xa;不推荐路径中带有空格。&#xa;留空即为默认值，重启 PCL 后生效。" HintText="默认">
                        <local:MyTextBox.ValidateRules>
                            <local:ValidateNullable />
                            <local:ValidateFolderPath UseMinecraftCharCheck="False" />
                        </local:MyTextBox.ValidateRules>
                    </local:MyTextBox>
                    <Grid Height="35" Grid.Row="7" Grid.ColumnSpan="5" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton Grid.Column="0" x:Name="BtnSystemUpdate" MinWidth="140" Text="检查更新" Padding="13,0" Margin="0,0,20,0" />
                        <local:MyButton Grid.Column="1" x:Name="BtnSystemSettingExp" MinWidth="140" Text="导出设置" Padding="13,0" Margin="0,0,20,0" />
                        <local:MyButton Grid.Column="2" x:Name="BtnSystemSettingImp" MinWidth="140" Text="导入设置" Padding="13,0" Margin="0,0,20,0" />
                    </Grid>
                    <!-- PCL3：已移除赞助解锁面板 -->
                </Grid>
            </local:MyCard>

            <!-- <local:MyCard x:Name="CardMain" Margin="0,15" Title="全局设置">
                <StackPanel Margin="25,40,25,15">
                    <Grid x:Name="PanMainLang" Height="28" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="语言" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboBackgroundSuit" Tag="UiBackgroundSuit" HorizontalAlignment="Left" Width="170" Grid.Column="1">
                            <local:MyComboBoxItem Content="简体中文" Tag="zh_CN" IsSelected="True" />
                            <local:MyComboBoxItem Content="繁體中文" Tag="zh_HK" />
                            <local:MyComboBoxItem Content="English" Tag="en_US" />
                        </local:MyComboBox>
                    </Grid>
                </StackPanel>
            </local:MyCard> -->
            <local:MyCard x:Name="CardDebug" Margin="0,0,0,15" Title="调试选项" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="25,40,25,15">
                    <Grid x:Name="PanDebugAnim" Height="22" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="动画速度" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderDebugAnim" local:SettingService.Key="SystemDebugAnim" MaxValue="30" Grid.Column="1" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <local:MyCheckBox Grid.Column="0" Text="禁止在下载时从其他文件夹复制文件" Height="22" x:Name="CheckDebugSkipCopy" local:SettingService.Key="SystemDebugSkipCopy" ToolTip="在下载时不直接复制其他 MC 文件夹中已经存在的相同文件，而是重新下载文件。&#xa;只建议在测试下载速度时开启。" />
                        <local:MyCheckBox Grid.Column="1" Text="调试模式" Height="22" x:Name="CheckDebugMode" local:SettingService.Key="SystemDebugMode" ToolTip="显示调试信息与更多错误信息。&#xa;这会导致启动器性能略有下降，若无特殊需要不建议开启。" />
                        <local:MyCheckBox Grid.Column="2" Text="添加延迟" Height="22" x:Name="CheckDebugDelay" local:SettingService.Key="SystemDebugDelay" ToolTip="在各个环节添加随机的延迟，拖慢加载速度，以测试部分功能是否正常运行。&#xa;这会严重影响启动器运行，若无特殊需要不建议开启。" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardEaster" Margin="0,0,0,15" Title="彩蛋">
                <StackPanel Margin="25,40,25,15">
                    <Grid Height="22" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="哀悼日灰色色调" Margin="0,0,25,0"
                                   ToolTip="每年 10 月 20 日（PCL2 下架哀悼日），启动器默认切换为灰色调以示默哀。&#xa;取消勾选后，哀悼日将保持所选主题的彩色外观（哀悼提示弹窗不受影响）。" />
                        <local:MyCheckBox local:SettingService.Key="SystemEasterMourningGray" Text="启用（每年 10 月 20 日）" Grid.Column="1" HorizontalAlignment="Left"
                                          ToolTip="勾选：哀悼日启动器整体变为灰色（含背景图片）。&#xa;取消勾选：哀悼日保持彩色外观。" />
                    </Grid>
                    <Grid Height="22" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="滑稽彩轮换速度" Margin="0,0,25,0"
                                   ToolTip="滑稽彩 / 真·滑稽彩 主题的颜色轮换速度，数值越大颜色变化越快。&#xa;普通滑稽彩每 250ms 前进一步，真·滑稽彩每 50ms 前进一步。" />
                        <local:MySlider x:Name="SliderEasterHue" local:SettingService.Key="SystemEasterHueStep" MaxValue="30" Value="3" Grid.Column="1" />
                    </Grid>
                    <local:MyHint Text="以下按钮可以直接体验 PCL 中隐藏的彩蛋，无需等待触发条件。" Theme="Blue" Margin="0,0,0,12" />
                    <WrapPanel>
                        <local:MyButton x:Name="BtnEasterHue12" Text="滑稽彩" MinWidth="140" Padding="13,0" Margin="0,0,20,10"
                                        ToolTip="切换到滑稽彩主题：颜色随界面刷新缓慢轮换。" />
                        <local:MyButton x:Name="BtnEasterHue13" Text="欧皇彩" MinWidth="140" Padding="13,0" Margin="0,0,20,10"
                                        ToolTip="切换到欧皇彩主题：随机一种颜色。再次点击可以重新随机。" />
                        <local:MyButton x:Name="BtnEasterReal" Text="真·滑稽彩" MinWidth="140" Padding="13,0" Margin="0,0,20,10" ColorType="Red"
                                        ToolTip="启动「千万别点」彩蛋的效果：界面颜色高速轮换。&#xa;再次点击即可停止并恢复原主题。" />
                        <local:MyButton x:Name="BtnEasterPlc" Text="PLC 彩蛋" MinWidth="140" Padding="13,0" Margin="0,0,20,10"
                                        ToolTip="千分之一概率出现的标题彩蛋：把标题栏 Logo 换成手绘的 PLC。&#xa;再次点击恢复原 Logo。" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardDeveloper" Margin="0,0,0,15" Title="开发者模式">
                <StackPanel Margin="25,40,25,15">
                    <TextBlock x:Name="LabDevVersion" Text="正在获取版本信息……" TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,10" />
                    <local:MyHint Text="以下工具用于模组开发与问题排查，普通使用无需改动。" Theme="Blue" Margin="0,0,0,12" />
                    <WrapPanel>
                        <local:MyButton x:Name="BtnDevLog" Text="打开日志文件" MinWidth="140" Padding="13,0" Margin="0,0,20,10"
                                        ToolTip="打开本次运行对应的 Log1.txt。" />
                        <local:MyButton x:Name="BtnDevFolder" Text="打开 PCL 文件夹" MinWidth="140" Padding="13,0" Margin="0,0,20,10"
                                        ToolTip="打开启动器所在目录。" />
                        <local:MyButton x:Name="BtnDevExport" Text="导出诊断信息" MinWidth="140" Padding="13,0" Margin="0,0,20,10"
                                        ToolTip="将版本、系统信息与最近的日志内容保存到桌面，便于反馈问题。" />
                        <local:MyButton x:Name="BtnDevCrash" Text="分析崩溃报告…" MinWidth="140" Padding="13,0" Margin="0,0,20,10"
                                        ToolTip="选择 crash-report、latest.log 或 PCL 日志文件，使用内置崩溃分析器进行分析。" />
                        <local:MyButton x:Name="BtnDevVersion" Text="打开版本文件夹" MinWidth="140" Padding="13,0" Margin="0,0,20,10"
                                        ToolTip="打开当前选中版本的 versions 文件夹。&#xa;便于放置或调试自定义 JSON、Forge/Fabric 安装器等。" />
                        <local:MyButton x:Name="BtnDevMods" Text="打开 mods 文件夹" MinWidth="140" Padding="13,0" Margin="0,0,20,10"
                                        ToolTip="打开当前选中版本（应用版本隔离后）实际使用的 mods 文件夹。&#xa;模组开发者可以将编译好的 Jar 拖入其中进行测试。" />
                        <local:MyButton x:Name="BtnDevJson" Text="打开版本 JSON" MinWidth="140" Padding="13,0" Margin="0,0,20,10"
                                        ToolTip="使用记事本打开当前选中版本的 JSON 文件。&#xa;可以查看或修改其继承的版本、启动参数与依赖库。" />
                    </WrapPanel>
                </StackPanel>
    </local:MyCard>
            <local:MyCard Margin="0,0,0,15" Title="AI 助手">
                <StackPanel Margin="25,40,25,15">
                    <local:MyHint Text="填写 API Key 后，PCL 在启动失败时可让 AI 分析报错原因与解决方案，还可以获取模组推荐和新手教学。&#xa;API Key 仅保存在本机，只会在你主动点击分析时将相关日志发送给所配置的 AI 服务。" Theme="Blue" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="9" />
                            <RowDefinition Height="28" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="35" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="API Key" Margin="0,0,25,0" />
                        <local:MyTextBox local:SettingService.Key="ToolApiKey" Grid.Column="1"
                                         HintText="sk-…（OpenAI 兼容接口密钥）" MaxLength="200"
                                         ToolTip="OpenAI 兼容接口的密钥，支持 DeepSeek、Kimi、智谱 GLM 等。&#xa;密钥会加密保存在本机，不会上传给 PCL。" />
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="接口地址" Margin="0,0,25,0" Grid.Row="2" />
                        <local:MyTextBox local:SettingService.Key="ToolAiUrl" Grid.Row="2" Grid.Column="1" MaxLength="500"
                                         HintText="默认：https://api.deepseek.com/chat/completions"
                                         ToolTip="Chat Completions 接口的完整地址。&#xa;例如 DeepSeek：https://api.deepseek.com/chat/completions&#xa;Kimi：https://api.moonshot.cn/v1/chat/completions&#xa;智谱 GLM：https://open.bigmodel.cn/api/paas/v4/chat/completions">
                            <local:MyTextBox.ValidateRules>
                                <local:ValidateNullable />
                                <local:ValidateHttp />
                            </local:MyTextBox.ValidateRules>
                        </local:MyTextBox>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="模型名称" Margin="0,0,25,0" Grid.Row="4" />
                        <local:MyTextBox local:SettingService.Key="ToolAiModel" Grid.Row="4" Grid.Column="1" MaxLength="100"
                                         HintText="默认：deepseek-chat"
                                         ToolTip="使用的模型名称，例如 deepseek-chat、moonshot-v1-8k、glm-4-flash 等。" />
                        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Left">
                            <local:MyButton x:Name="BtnAiTest" Text="测试连接" MinWidth="140" Padding="13,0" Margin="0,0,20,0"
                                            ToolTip="发送一条测试消息，验证 API Key、接口地址与模型名称是否配置正确。" />
                            <local:MyButton x:Name="BtnAiLogAnalyze" Text="AI 分析本次日志" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ColorType="Highlight"
                                            ToolTip="让 AI 分析 PCL 日志与当前版本的错误情况，排查启动问题。" />
                            <local:MyButton x:Name="BtnAiMods" Text="AI 模组推荐" MinWidth="140" Padding="13,0" Margin="0,0,20,0"
                                            ToolTip="根据当前选中的游戏版本与 Mod 加载器，让 AI 推荐适合的 Mod。" />
