<Grid x:Class="MySkinViewer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PCL"
      Background="Transparent" ClipToBounds="True" Cursor="SizeAll">
    <Viewport3D x:Name="Viewport" ClipToBounds="True">
        <Viewport3D.Camera>
            <OrthographicCamera x:Name="Camera" Position="0,0,100" LookDirection="0,0,-1" UpDirection="0,1,0" Width="50" />
        </Viewport3D.Camera>
        <ModelVisual3D x:Name="Model">
            <ModelVisual3D.Content>
                <Model3DGroup x:Name="Models">
                    <AmbientLight Color="#909090" />
                    <DirectionalLight Color="#C8C8C8" Direction="-0.4,-1,-0.7" />
                    <DirectionalLight Color="#787878" Direction="0.7,0.2,0.8" />
                    <DirectionalLight Color="#404040" Direction="0.2,0.5,-0.8" />
                </Model3DGroup>
            </ModelVisual3D.Content>
        </ModelVisual3D>
    </Viewport3D>
</Grid>
