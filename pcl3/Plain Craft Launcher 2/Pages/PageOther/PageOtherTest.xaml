<local:MyPageRight x:Class="PageOtherTest"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:PCL"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10">
            <!--结构对齐官方 PCL2：百宝箱 / 回声洞 / 下载自定义文件-->
            <local:MyCard Margin="0,15,0,15" Title="百宝箱">
                <WrapPanel Margin="25,42,6,10">
                    <local:MyButton x:Name="BtnJrrp" Text="今日人品" MinWidth="140" Height="35" Padding="13,0" Margin="0,0,15,12" ColorType="Highlight"
                                    ToolTip="看看今天的人品值有多高！" />
                    <local:MyButton x:Name="BtnMemory" Text="内存优化" MinWidth="140" Height="35" Padding="13,0" Margin="0,0,15,12"
                                    ToolTip="将物理内存占用降低约 1/3，不仅限于 MC！&#xa;如果使用机械硬盘，这可能会导致一小段时间的严重卡顿。&#xa;使用 --memory 参数启动 PCL 可以静默执行内存优化。" />
                    <local:MyButton x:Name="BtnClear" Text="清理游戏垃圾" MinWidth="140" Height="35" Padding="13,0" Margin="0,0,15,12"
                                    ToolTip="清理 PCL 的缓存与 MC 的日志、崩溃报告等垃圾文件" />
                    <local:MyButton x:Name="BtnClick" Text="千万别点" MinWidth="140" Height="35" Padding="13,0" Margin="0,0,15,12" ColorType="Red" />
                </WrapPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardCave" Margin="0,0,0,15" Title="回声洞">
                <StackPanel Margin="25,39,25,16">
                    <TextBlock x:Name="LabCave" Text="反复点击这里可以查看 PCL 作者与各位沙雕网友乱七八糟的留言！"
                               TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource ColorBrush1}" />
                    <local:MyTextButton x:Name="BtnCave" Text="投稿" Margin="0,10,0,7"
                                        ToolTip="前往回声洞投稿页面。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardDownload" Margin="0,0,0,15" Title="下载自定义文件">
                <Grid Margin="25,38,25,21">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28" />
                        <RowDefinition Height="11" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="28" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="35" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="下载地址" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextDownloadUrl" Grid.Row="0" Grid.ColumnSpan="2" Grid.Column="1"
                                     HintText="https://example.com/file.zip"
                                     ToolTip="使用 PCL 的高速多线程下载引擎下载任意文件。&#xa;请注意，部分网站（例如百度网盘）可能会报错 403 已禁止，无法正常下载。">
                        <local:MyTextBox.ValidateRules>
                            <local:ValidateHttp />
                        </local:MyTextBox.ValidateRules>
                    </local:MyTextBox>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="保存到" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextDownloadFolder" Grid.Row="2" Grid.Column="1" HintText="选择保存文件夹">
                        <local:MyTextBox.ValidateRules>
                            <local:ValidateFolderPath UseMinecraftCharCheck="False" />
                        </local:MyTextBox.ValidateRules>
                    </local:MyTextBox>
                    <local:MyTextButton x:Name="BtnDownloadSelect" Grid.Row="2" Grid.Column="2" Text="选择…" Margin="12,0,0,0"
                                        ToolTip="选择保存文件的目标文件夹。" />
                    <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="文件名" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextDownloadName" Grid.Row="4" Grid.ColumnSpan="2" Grid.Column="1" HintText="留空则从下载地址自动获取">
                        <local:MyTextBox.ValidateRules>
                            <local:ValidateFileName UseMinecraftCharCheck="False" RequireParentFolderExists="False" />
                        </local:MyTextBox.ValidateRules>
                    </local:MyTextBox>
                    <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Grid.Column="0" Orientation="Horizontal" Margin="-8,7,-8,0">
                        <local:MyButton x:Name="BtnDownloadStart" Text="开始下载" Width="135" Padding="13,0" Margin="8,0,8,0" ColorType="Highlight" IsEnabled="False" />
                        <local:MyButton x:Name="BtnDownloadOpen" Text="打开文件夹" Width="135" Padding="13,0" Margin="8,0,8,0" />
                    </StackPanel>
                </Grid>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
